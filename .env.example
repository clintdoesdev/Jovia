# Postgres connection string used by Prisma (see prisma.config.ts).
DATABASE_URL="postgresql://jovia:jovia@localhost:5432/jovia"

# Secret used to sign session JWTs (lib/auth.ts). Generate with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# KoraPay secret key (lib/korapay.ts) — from your KoraPay dashboard under
# Settings > API Keys. Used both to authenticate charge-initialize requests
# and to verify the x-korapay-signature header on incoming webhooks, so it
# must be the live/test key that matches whichever mode your dashboard's
# webhook URL is configured for.
KORAPAY_SECRET_KEY="replace-with-your-korapay-secret-key"

# Bootstraps one admin account (prisma/seed.ts) with access to /admin —
# invites, members, and payments. Run `npm run db:seed` after setting these
# to create or update that account. Change the password afterward from a
# real login if this ever ran against production with a placeholder value.
ADMIN_EMAIL="admin@joviawebsite.com.ng"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Real Telegram group invite link (e.g. https://t.me/+AbCdEfGhIjK), shown to
# newly activated members. Falls back to the vendor DM link until this is
# set, since a placeholder t.me link would just be a broken link.
TELEGRAM_GROUP_URL=""
